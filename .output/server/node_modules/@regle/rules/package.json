{
  "name": "@regle/rules",
  "version": "1.17.0",
  "description": "Collection of rules and helpers for Regle",
  "dependencies": {
    "type-fest": "5.3.1",
    "@regle/core": "1.17.0"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@vue/reactivity": "3.5.26",
    "@vue/test-utils": "2.4.6",
    "prettier": "3.7.4",
    "tsdown": "0.18.3",
    "type-fest": "5.3.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16",
    "vue": "3.5.26",
    "vue-tsc": "3.2.1"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/regle-rules.d.ts",
      "production": "./dist/regle-rules.min.js",
      "development": "./dist/regle-rules.js",
      "default": "./dist/regle-rules.min.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/regle-rules.js",
  "module": "./dist/regle-rules.js",
  "types": "./dist/regle-rules.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "Victor Garcia",
    "url": "https://github.com/victorgarciaesgi"
  },
  "homepage": "https://reglejs.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorgarciaesgi/regle.git"
  },
  "license": "MIT",
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "build": "tsdown",
    "build:sourcemaps": "tsdown --config=tsdown.sourcemap.ts",
    "dev": "tsdown --config=tsdown.dev.ts --watch",
    "test": "vitest run"
  }
}