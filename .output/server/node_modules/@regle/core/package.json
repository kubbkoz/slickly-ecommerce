{
  "name": "@regle/core",
  "version": "1.17.0",
  "description": "Headless form validation library for Vue",
  "peerDependencies": {
    "pinia": ">=2.2.5",
    "vue": ">=3.3.0"
  },
  "peerDependenciesMeta": {
    "pinia": {
      "optional": true
    }
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "@vue/devtools-api": "7.7.9",
    "type-fest": "5.3.1"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "22.19.3",
    "@vue/devtools-kit": "7.7.9",
    "@vue/test-utils": "2.4.6",
    "prettier": "3.7.4",
    "tsdown": "0.18.3",
    "typescript": "5.9.3",
    "vitest": "4.0.16",
    "vue": "3.5.26",
    "vue-tsc": "3.2.1"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/regle-core.d.ts",
      "production": "./dist/regle-core.min.js",
      "development": "./dist/regle-core.js",
      "default": "./dist/regle-core.min.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "main": "./dist/regle-core.js",
  "module": "./dist/regle-core.js",
  "types": "./dist/regle-core.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://reglejs.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorgarciaesgi/regle.git"
  },
  "author": {
    "name": "Victor Garcia",
    "url": "https://github.com/victorgarciaesgi"
  },
  "keywords": [
    "regle",
    "vue forms",
    "vue validation library",
    "vue forms typescript",
    "vue model validation",
    "vue zod",
    "vue typescript forms",
    "regle",
    "reglejs",
    "regle vue",
    "regle vue forms",
    "regle vue form"
  ],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "build:sourcemaps": "tsdown --config=tsdown.sourcemap.ts",
    "dev": "tsdown --config=tsdown.dev.ts",
    "test": "echo 'no tests'"
  }
}