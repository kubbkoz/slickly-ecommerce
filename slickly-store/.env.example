# =============================================================================
# SLICKLY — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored. .env.example is tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SITE_URL=https://slickly.sk

# -----------------------------------------------------------------------------
# Shopware Store API (public — exposed to client)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SHOPWARE_ENDPOINT=https://mtsport.store/store-api/
NUXT_PUBLIC_SHOPWARE_ACCESS_TOKEN=your_store_api_access_token_here

# -----------------------------------------------------------------------------
# Shopware Admin API (server-only — never exposed to client)
# Vytvoriť v Shopware Admin > Nastavenia > Integrácie
# Vyžadované oprávnenia (scopes):
#   - Customer (čítanie + zápis) — pre OAuth account linking (silent password rotation)
#   - Médiá (čítanie)             — pre /api/resolve-media (image URL resolver)
# -----------------------------------------------------------------------------
SHOPWARE_ADMIN_ENDPOINT=https://yourdomain.com/api/
SHOPWARE_ADMIN_CLIENT_ID=your_admin_oauth_client_id_here
SHOPWARE_ADMIN_CLIENT_SECRET=your_admin_oauth_client_secret_here

# -----------------------------------------------------------------------------
# Shopware Sales Channel & Root Navigation Category
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SW_ID_SALES_CHANNEL=your_sales_channel_id_here
NUXT_PUBLIC_SW_ID_ROOT_CATEGORY=your_root_category_id_here

# -----------------------------------------------------------------------------
# Shopware Language IDs
# (found in Admin → Settings → Languages)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SW_ID_LANG_SK=
NUXT_PUBLIC_SW_ID_LANG_CZ=
NUXT_PUBLIC_SW_ID_LANG_PL=
NUXT_PUBLIC_SW_ID_LANG_EN=
NUXT_PUBLIC_SW_ID_LANG_DE=
NUXT_PUBLIC_SW_ID_LANG_HU=

# -----------------------------------------------------------------------------
# Shopware Category IDs
# (found in Admin → Catalogues → Categories → ID column)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SW_ID_CAT_HOME_SLIDER=
NUXT_PUBLIC_SW_ID_CAT_HOME_GRID_SUB=
NUXT_PUBLIC_SW_ID_CAT_FEATURED=
NUXT_PUBLIC_SW_ID_CAT_FLASH_SALES=
NUXT_PUBLIC_SW_ID_CAT_BIKES=
NUXT_PUBLIC_SW_ID_CAT_EBIKES=
NUXT_PUBLIC_SW_ID_CAT_DOPLNKY=
NUXT_PUBLIC_SW_ID_CAT_KOMPONENTY=
NUXT_PUBLIC_SW_ID_CAT_OBLECENIE=

# -----------------------------------------------------------------------------
# Shopware Shipping Method IDs
# (found in Admin → Settings → Shipping)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SW_ID_SHIPPING_BALIKOVO=
NUXT_PUBLIC_SW_ID_SHIPPING_TOPTRANS=
NUXT_PUBLIC_SW_ID_SHIPPING_SPS=
NUXT_PUBLIC_SW_ID_SHIPPING_OSOBNY_ODBER=

# -----------------------------------------------------------------------------
# Shopware Property Group IDs
# (found in Admin → Catalogues → Properties)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SW_ID_PROP_GROUP_FRAME_SIZE=
NUXT_PUBLIC_SW_ID_PROP_GROUP_SIZE=
NUXT_PUBLIC_SW_ID_PROP_GROUP_COLOR=

# -----------------------------------------------------------------------------
# Shopware Currency IDs
# (found in Admin → Settings → Currencies)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_SW_ID_CURRENCY_EUR=

# -----------------------------------------------------------------------------
# AI Services (server-only)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# OAuth — Sociálne prihlásenie (server-only)
# Google: console.cloud.google.com → APIs → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: https://yourdomain.com/api/oauth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: developers.facebook.com → App → Facebook Login → Settings
# Valid OAuth Redirect URI: https://yourdomain.com/api/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# -----------------------------------------------------------------------------
# WebAuthn / Passkeys — Biometrické prihlásenie (server-only)
# RP_ID musí zodpovedať doméne (bez portu, bez protokolu)
# -----------------------------------------------------------------------------
WEBAUTHN_RP_ID=slickly.sk
WEBAUTHN_RP_NAME=SLICKLY

# Šifrovací kľúč AES-256 pre OAuth credentials v cache
# Vygeneruj: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=

# Webhook secret pre n8n → Nuxt push (order stav)
# Vygeneruj: openssl rand -hex 32
WEBHOOK_SECRET=

# n8n webhook URL — Nuxt zavolá n8n ako fallback pri cache miss
N8N_WEBHOOK_URL=https://n8n.slickly.sk/webhook/order-status
